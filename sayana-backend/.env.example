############################################################
# Core service configuration
############################################################
MONGO_URI=mongodb://localhost:27017/sayana-db
PORT=5000
JWT_SECRET=change-me-to-a-long-random-secret

############################################################
# Google / Gemini models (used by aiController & agentController)
# Provide at least one of these keys; comma-separated lists supported.
############################################################
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Optional single-key fallbacks read by the same controllers:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Preferred default model identifiers:
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_SIGN_MODEL=gemini-2.5-flash
GEMINI_SENTENCE_MODEL=gemini-2.5-flash

############################################################
# Gloss-to-sentence rewriting (signController)
############################################################
SENTENCE_GAP_MS=2500
SENTENCE_MAX_TOKENS=12

############################################################
# Hugging Face sign-classifier (signController)
############################################################
HF_API_KEY=your_token_here
# Comma-separated priority list. The backend will try each until one responds.
HF_SIGN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct,Qwen/Qwen2.5-VL-72B-Instruct,mistralai/Pixtral-12B-2409
HF_TIMEOUT_MS=12000

############################################################
# Landmark extraction bridge (MediaPipe Holistic)
# SIGN_PYTHON_BIN defaults to system "python" if unset.
############################################################
SIGN_PYTHON_BIN=.\\venv\\Scripts\\python.exe
HOLISTIC_TIMEOUT_MS=15000
SIGN_HOLISTIC_COMPLEXITY=1

############################################################
# Legacy pose-estimation stage (VitPose bridge)
# These are only read if you wire up the VitPose pipeline.
############################################################
VITPOSE_PYTHON_BIN=.\\venv\\Scripts\\python.exe
VITPOSE_MODEL_ID=OpenGVLab/vitpose-base-multi-decoder
VITPOSE_TIMEOUT_MS=15000

############################################################
# Developer scripts / utilities
############################################################
# DEV_SEED_PLAIN=plaintext-password-for-seed-user
